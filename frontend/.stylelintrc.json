{
  "extends": "stylelint-config-standard-scss",
  "rules": {
    "selector-class-pattern": null,
    "at-rule-no-unknown": null,
    "scss/at-rule-no-unknown": [
      true,
      {
        "ignoreAtRules": [
          "tailwind",
          "apply",
          "layer",
          "screen",
          "variants",
          "responsive",
          "theme",
          "source",
          "utility",
          "variant",
          "custom-variant",
          "config",
          "plugin",
          "reference"
        ]
      }
    ],
    "custom-property-pattern": null
  }
}
