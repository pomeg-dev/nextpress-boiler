NEXT_PUBLIC_API_URL=http://localhost

# Public site URL for canonical, og:url and the sitemap proxy. Set it here, not in
# WordPress `frontend_url`: the plugin uses that for its server-side fetch.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared secret for preview-token signing and the revalidate webhook. Must match
# NEXTPRESS_CLIENT_SECRET in wp-config.php. Server-only (never prefix NEXT_PUBLIC_).
# No fallback: preview and revalidate throw if it is unset. Generate one per environment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTPRESS_CLIENT_SECRET=