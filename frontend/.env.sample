NEXT_PUBLIC_API_URL=http://localhost

# Block sync — `npm run blocks:push` sends themes/*/blocks/*/fields.json to WP.
# Secret comes from wp-admin > Nextpress > Blocks (or WP's NEXTPRESS_SYNC_SECRET).
# NEXTPRESS_WP_URL defaults to NEXT_PUBLIC_API_URL. Extra targets use a suffix:
#   npm run blocks:push -- --target=staging → NEXTPRESS_WP_URL_STAGING / NEXTPRESS_SYNC_SECRET_STAGING
# NEXTPRESS_WP_URL=http://localhost
NEXTPRESS_SYNC_SECRET=

# Live page-preview HMAC secret — must match WP's NEXTPRESS_PREVIEW_SECRET.
# Server-only (never prefix NEXT_PUBLIC_). Generate a fresh one per environment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTPRESS_PREVIEW_SECRET=c1492212c32302f323046d9bfb9496980b175da70b0f9004154272e8cbc273be

